<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>کارگاه کامپیوتر | مهندسی کامپیوتر</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Tahoma, Arial, sans-serif;
            background: #090b10;
            color: #f5f5f5;
            line-height: 1.8;
        }

        /* Navbar */

        header {
            background: #0d1017;
            border-bottom: 1px solid #242833;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav {
            max-width: 1150px;
            margin: auto;
            padding: 18px 25px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            direction: ltr;
            font-size: 20px;
            font-weight: bold;
        }

        .logo span {
            color: #ff3b3b;
        }

        .menu {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .menu a {
            color: #c4c7cf;
            text-decoration: none;
            transition: 0.3s;
        }

        .menu a:hover {
            color: #ff3b3b;
        }

        /* Hero */

        .hero {
            max-width: 1150px;
            min-height: 600px;
            margin: auto;
            padding: 70px 25px;

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 60px;
        }

        .hero-text {
            max-width: 600px;
        }

        .tag {
            color: #ff3b3b;
            font-size: 13px;
            letter-spacing: 3px;
            direction: ltr;
        }

        h1 {
            font-size: 58px;
            line-height: 1.3;
            margin: 15px 0;
        }

        h1 span {
            color: #ff3b3b;
        }

        .hero-text p {
            color: #a5a9b4;
            font-size: 17px;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background: #ff3b3b;
            color: white;
            text-decoration: none;
            padding: 10px 28px;
            border-radius: 7px;
            transition: 0.3s;
        }

        .btn:hover {
            background: #d82d2d;
            transform: translateY(-3px);
        }

        /* Computer */

        .computer {
            width: 400px;
        }

        .monitor {
            background: #11151d;
            border: 8px solid #292e38;
            border-radius: 15px;
            height: 260px;
            padding: 25px;

            box-shadow: 0 0 45px rgba(255, 59, 59, 0.12);
        }

        .code {
            direction: ltr;
            text-align: left;
            font-family: Consolas, monospace;
            line-height: 2;
            color: #d5d8df;
        }

        .code .red {
            color: #ff3b3b;
        }

        .stand {
            width: 70px;
            height: 35px;
            background: #292e38;
            margin: auto;
        }

        .base {
            width: 170px;
            height: 10px;
            background: #292e38;
            margin: auto;
            border-radius: 10px;
        }

        /* Sections */

        section {
            padding: 80px 25px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-title span {
            color: #ff3b3b;
            font-size: 13px;
            letter-spacing: 3px;
        }

        .section-title h2 {
            font-size: 32px;
            margin-top: 5px;
        }

        /* About */

        .about {
            background: #10131a;
        }

        .cards {
            max-width: 1100px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .card {
            background: #171b23;
            border: 1px solid #282d37;
            padding: 30px 25px;
            border-radius: 12px;
            text-align: center;

            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-7px);
            border-color: #ff3b3b;
        }

        .icon {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: #9da2ad;
            font-size: 14px;
        }

        /* Topics */

        .topics {
            max-width: 1100px;
            margin: auto;
        }

        .topic-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .topic {
            background: #12151c;
            border: 1px solid #272c36;
            padding: 25px;
            border-radius: 10px;
            transition: 0.3s;
        }

        .topic:hover {
            border-color: #ff3b3b;
            transform: translateY(-5px);
        }

        .number {
            color: #ff3b3b;
            font-family: Consolas, monospace;
            font-size: 18px;
        }

        .topic h3 {
            margin: 8px 0;
        }

        .topic p {
            color: #999da8;
            font-size: 14px;
        }

        /* Skills */

        .skills {
            background: #10131a;
        }

        .skill-box {
            max-width: 850px;
            margin: auto;
        }

        .skill {
            margin-bottom: 25px;
        }

        .skill-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 7px;
        }

        .progress {
            background: #282d37;
            height: 9px;
            border-radius: 20px;
        }

        .progress div {
            height: 100%;
            background: #ff3b3b;
            border-radius: 20px;
        }

        .p90 {
            width: 90%;
        }

        .p80 {
            width: 80%;
        }

        .p75 {
            width: 75%;
        }

        .p65 {
            width: 65%;
        }

        /* Footer */

        footer {
            text-align: center;
            padding: 40px 20px;
            border-top: 1px solid #242833;
            color: #9296a1;
        }

        footer strong {
            color: #ff3b3b;
        }

        /* Responsive */

        @media (max-width: 800px) {

            nav {
                flex-direction: column;
                gap: 15px;
            }

            .hero {
                flex-direction: column;
                text-align: center;
            }

            h1 {
                font-size: 43px;
            }

            .computer {
                width: 90%;
            }

            .cards,
            .topic-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 500px) {

            .menu {
                gap: 12px;
                font-size: 13px;
            }

            h1 {
                font-size: 35px;
            }

            .monitor {
                height: 220px;
            }
        }
    </style>
</head>


<body>

    <!-- Navigation -->

    <header>
        <nav>

            <div class="logo">
                <span>&lt;/&gt;</span> Computer Lab
            </div>

            <ul class="menu">
                <li><a href="#home">خانه</a></li>
                <li><a href="#about">درباره درس</a></li>
                <li><a href="#topics">سرفصل‌ها</a></li>
                <li><a href="#skills">مهارت‌ها</a></li>
            </ul>

        </nav>
    </header>


    <!-- Hero -->

    <section class="hero" id="home">

        <div class="hero-text">

            <span class="tag">COMPUTER ENGINEERING</span>

            <h1>
                کارگاه
                <span>کامپیوتر</span>
            </h1>

            <p>
                آشنایی با مفاهیم پایه کامپیوتر، سخت‌افزار،
                نرم‌افزار، برنامه‌نویسی، شبکه و مهارت‌های
                عملی مورد نیاز دانشجویان رشته مهندسی کامپیوتر.
            </p>

            <a href="#about" class="btn">
                شروع یادگیری
            </a>

        </div>


        <div class="computer">

            <div class="monitor">

                <div class="code">

                    <span class="red">01</span>
                    &lt;computer&gt;<br>

                    <span class="red">02</span>
                    &nbsp;&nbsp;learn();<br>

                    <span class="red">03</span>
                    &nbsp;&nbsp;code();<br>

                    <span class="red">04</span>
                    &nbsp;&nbsp;create();<br>

                    <span class="red">05</span>
                    &nbsp;&nbsp;solve_problem();<br>

                    <span class="red">06</span>
                    &lt;/computer&gt;

                </div>

            </div>

            <div class="stand"></div>
            <div class="base"></div>

        </div>

    </section>


    <!-- About -->

    <section class="about" id="about">

        <div class="section-title">

            <span>ABOUT THE COURSE</span>

            <h2>
                درباره درس کارگاه کامپیوتر
            </h2>

        </div>


        <div class="cards">

            <div class="card">

                <div class="icon">💻</div>

                <h3>یادگیری عملی</h3>

                <p>
                    در این درس دانشجو با کار عملی
                    با سیستم کامپیوتری و ابزارهای مختلف
                    آشنا می‌شود.
                </p>

            </div>


            <div class="card">

                <div class="icon">⌨️</div>

                <h3>مهارت‌های کامپیوتری</h3>

                <p>
                    مهارت‌های پایه کار با سیستم،
                    نرم‌افزارها و ابزارهای کامپیوتری
                    تقویت می‌شوند.
                </p>

            </div>


            <div class="card">

                <div class="icon">🚀</div>

                <h3>آمادگی برای آینده</h3>

                <p>
                    این مهارت‌ها می‌توانند پایه‌ای
                    برای ورود به برنامه‌نویسی و حوزه‌های
                    تخصصی کامپیوتر باشند.
                </p>

            </div>

        </div>

    </section>


    <!-- Topics -->

    <section id="topics">

        <div class="section-title">

            <span>COURSE TOPICS</span>

            <h2>سرفصل‌های کارگاه</h2>

        </div>


        <div class="topic-grid">

            <div class="topic">
                <span class="number">01</span>
                <h3>سخت‌افزار</h3>
                <p>
                    آشنایی با CPU، RAM، مادربرد،
                    حافظه و سایر قطعات کامپیوتر.
                </p>
            </div>


            <div class="topic">
                <span class="number">02</span>
                <h3>سیستم‌عامل</h3>
                <p>
                    آشنایی با سیستم‌عامل و مدیریت
                    فایل‌ها و تنظیمات سیستم.
                </p>
            </div>


            <div class="topic">
                <span class="number">03</span>
                <h3>برنامه‌نویسی</h3>
                <p>
                    آشنایی اولیه با الگوریتم،
                    منطق برنامه‌نویسی و کدنویسی.
                </p>
            </div>


            <div class="topic">
                <span class="number">04</span>
                <h3>شبکه</h3>
                <p>
                    آشنایی با مفاهیم اولیه شبکه،
                    اینترنت و ارتباط بین سیستم‌ها.
                </p>
            </div>


            <div class="topic">
                <span class="number">05</span>
                <h3>نرم‌افزار</h3>
                <p>
                    استفاده از نرم‌افزارهای کاربردی
                    و ابزارهای مورد نیاز دانشجو.
                </p>
            </div>


            <div class="topic">
                <span class="number">06</span>
                <h3>امنیت</h3>
                <p>
                    آشنایی با امنیت اطلاعات،
                    رمز عبور و محافظت از سیستم.
                </p>
            </div>

        </div>

    </section>


    <!-- Skills -->

    <section class="skills" id="skills">

        <div class="section-title">

            <span>SKILLS</span>

            <h2>مهارت‌های مورد نیاز</h2>

        </div>


        <div class="skill-box">

            <div class="skill">

                <div class="skill-info">
                    <span>کار با کامپیوتر</span>
                    <span>90%</span>
                </div>

                <div class="progress">
                    <div class="p90"></div>
                </div>

            </div>


            <div class="skill">

                <div class="skill-info">
                    <span>سیستم‌عامل</span>
                    <span>80%</span>
                </div>

                <div class="progress">
                    <div class="p80"></div>
                </div>

            </div>


            <div class="skill">

                <div class="skill-info">
                    <span>برنامه‌نویسی</span>
                    <span>75%</span>
                </div>

                <div class="progress">
                    <div class="p75"></div>
                </div>

            </div>


            <div class="skill">

                <div class="skill-info">
                    <span>حل مسئله</span>
                    <span>65%</span>
                </div>

                <div class="progress">
                    <div class="p65"></div>
                </div>

            </div>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <p>
            ساخته شده برای پروژه درس
            <strong>کارگاه کامپیوتر</strong>
        </p>

        <p>
            Computer Engineering Student © 2026
        </p>

    </footer>

</body>

</html>
